# Vantage Core - Python .gitignore

# Virtual environment
.venv/
venv/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Database / Company files (never commit real company data)
*.vantage
*.cdf
*.db
test_*.cdf

# IDE and editor folders
.vscode/
.idea/

# Distribution / packaging
dist/
build/
*.egg-info/

# Logs and temporary files
*.log
*.tmp
*.temp

# OS generated files
.DS_Store
Thumbs.db

# pip cache (optional but recommended)
pip-log.txt
pip-delete-this-directory.txt

# Local backups and last-used company state
Main Backups/
last_company.json
recent_companies.json